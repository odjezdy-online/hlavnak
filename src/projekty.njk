---
layout: base.njk
permalink: /projekty/
title: Projekty a podpora
boardTitle: "PROJEKTY"
description: "Všechny projekty kolem odjezdy.online a jak je podpořit."
---
{#- the list lives in src/_data/projects.json -#}
<h1 class="list-title">Projekty a podpora</h1>

<section class="give" aria-labelledby="give-h">
  <h2 id="give-h" class="group-head"><span class="c-cat box c-give">PODPORA</span><span>Podpořit</span></h2>
  <ul class="give-list">
    {%- for d in projects.donate %}
    <li class="proj-row"><a class="c-title" href="{{ d.url }}" target="_blank" rel="noopener"><span class="t">{{ d.name }}</span></a><span class="p-desc">{{ d.desc }}</span><span class="p-host">{{ d.url | shortUrl }}</span></li>
    {%- endfor %}
    {%- for c in projects.crypto %}
    <li class="proj-row crypto"><span class="c-title"><span class="t">{{ c.name }}</span></span><code class="p-addr">{{ c.address }}</code><button type="button" class="copy" data-copy="{{ c.address }}">Kopírovat adresu</button></li>
    {%- endfor %}
  </ul>
</section>

{%- for g in projects.groups %}
<section class="proj-group" aria-labelledby="g-{{ loop.index }}">
  <h2 id="g-{{ loop.index }}" class="group-head"><span class="c-cat box c-{{ g.code | lower }}">{{ g.code }}</span><span>{{ g.title }}</span></h2>
  <ol class="proj-list">
    {%- for p in g.items %}
    <li class="proj-row">
      <a class="c-title" href="{{ p.url }}" rel="noopener"><span class="t">{{ p.name }}</span></a>
      {%- if p.desc %}<span class="p-desc">{{ p.desc }}</span>{% endif %}
      <span class="p-host">{{ p.url | shortUrl }}</span>
      <span class="p-status s-{{ p.status | replace('ý', 'y') }}">{{ p.status | upper }}</span>
    </li>
    {%- endfor %}
  </ol>
</section>
{%- endfor %}
